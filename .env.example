# Copy this file to .env and fill in real values. Never commit .env.
# Supabase project — anon key only in the app. Service key stays in GitHub secrets.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Environment label: development | staging | production
APP_ENV=development

# Where the password-reset email sends the user (FR-1.5). A page on the marketing
# site completes the reset; the desktop app has no URL to land on.
APP_PASSWORD_RESET_URL=https://www.raskosweetscent.com/reset-password
