{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RSS Management System",
  "mainBinaryName": "RSS Management System",
  "version": "0.1.0",
  "identifier": "ke.rasko.sweetscent",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RSS Management System",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://github.com https://objects.githubusercontent.com https://*.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Rasko Sweet Scent",
    "category": "Business",
    "shortDescription": "RSS Management System for Rasko Sweet Scent",
    "longDescription": "RSS Management System: offline-first business management for Rasko Sweet Scent, covering clients, orders, invoices, payments, inventory, purchases and payroll.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQkU1MTg0NUZGMUIzRDUKUldUVnMvRmZoRkcrSVZZQ0d1UC9DSkUva095ZEpVbzhnMlRRWjNNL01xdFV5Y1VxWXovd01mZU0K",
      "endpoints": [
        "https://github.com/DecodeDedan/rasko-sweet-scent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
